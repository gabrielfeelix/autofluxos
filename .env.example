# Copie para .env e preencha. NUNCA comite o .env — este repositório é público.
# Aqui ficam apenas os NOMES das variáveis, jamais os valores.

# --- Supabase (Etapa 1, passo 3) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- WhatsApp Cloud API (Etapa 1, passo 6) ---
# Token do app da Meta. O WABA é do CLIENTE (Embedded Signup), não nosso.
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
# Segredo que a gente escolhe e repete no painel da Meta ao registrar o webhook.
WHATSAPP_VERIFY_TOKEN=

# --- IA (Etapa 2) ---
# Em produção a chave é do cliente (BYOK) e fica no Vault, não aqui.
# Esta é só para desenvolvimento, com dado FICTÍCIO — o free tier do Gemini
# usa entrada e saída para treinar modelo.
GEMINI_API_KEY_DEV=
