# Ambiente de teste de integração LOCAL.
#
# Copie para `.env.teste-local`. O `vitest.integration.config.ts` lê este
# arquivo e nunca o `.env`, que guarda a credencial de produção.
#
# O endereço precisa ser local de verdade (localhost, 127.0.0.1). O guarda em
# `test/ambiente-local.ts` recusa qualquer host remoto, mesmo com o
# consentimento abaixo preenchido: AutoFluxos e Verandi dividem o projeto de
# produção, e um teste que cria e apaga registro lá mexe no banco de cliente.
#
# Subir o Supabase local: `npx supabase start` (imprime a URL e a chave).

AUTOFLUXOS_TESTE_LOCAL=sim
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SECRET_KEY=cole-aqui-a-service-role-do-supabase-local
